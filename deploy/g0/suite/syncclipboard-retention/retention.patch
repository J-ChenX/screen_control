+    /// <summary>按创建时间清理过期非收藏记录；置顶不豁免，保留删除标记供离线客户端同步。</summary>
+    public async Task<int> CleanupExpiredHistory(uint retentionHours, DateTime utcNow, CancellationToken token = default)
+    {
+        if (retentionHours == 0) return 0;
+        if (utcNow.Kind != DateTimeKind.Utc) throw new ArgumentException("清理时钟必须为 UTC", nameof(utcNow));
+        var cutoff = utcNow.AddHours(-(double)retentionHours);
+        // 与收藏更新共用锁，避免先查后删期间误删刚收藏的记录。
+        await _sem.WaitAsync(token);
+        using var guard = new ScopeGuard(() => _sem.Release());
+        var expired = await _dbContext.HistoryRecords
+            .Where(r => r.UserId == HARD_CODED_USER_ID && !r.IsDeleted && !r.Stared && r.CreateTime < cutoff)
+            .OrderBy(r => r.CreateTime).ThenBy(r => r.ID)
+            .Take(100).ToListAsync(token);
+        foreach (var record in expired)
+        {
+            record.IsDeleted = true;
+            record.LastModified = utcNow;
+            record.Version = checked(record.Version + 1);
+        }
+        await _dbContext.SaveChangesAsync(token);
+        foreach (var record in expired)
+        {
+            await NotifyProfileChangeAsync(record);
+            await DeleteProfileDataIfNeed(record, token);
+        }
+        return expired.Count;
+    }
