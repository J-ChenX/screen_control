[Unit]
Description=Screen Control G0 MeshAgent（仅限 Tailscale）
Documentation=https://github.com/Ylianst/MeshCentral
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=-/etc/screen-control/meshagent.env
WorkingDirectory=/opt/screen-control/meshagent
ExecStartPre=/usr/local/libexec/screen-control-meshagent-firewall apply
ExecStart=/opt/screen-control/meshagent/meshagent
ExecStopPost=/usr/local/libexec/screen-control-meshagent-firewall remove
# 同步诊断子进程不能因高水位无限节流；保留硬上限和整组 OOM 清理。
MemoryAccounting=yes
MemoryHigh=infinity
MemoryMax=768M
MemorySwapMax=128M
OOMPolicy=kill
TimeoutStopSec=15s
KillMode=control-group
SendSIGKILL=yes
Restart=always
RestartSec=5s
User=root
Group=root
UMask=0077
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
