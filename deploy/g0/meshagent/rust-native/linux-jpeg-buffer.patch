+
+void release_JPEG_buffer(void)
+{
+	free(jpeg_buffer);
+	jpeg_buffer = NULL;
+	jpeg_buffer_length = 0;
+	jpeg_buffer_capacity = 0;
+}
+
+void finish_JPEG_tile(void)
+{
+	// 避免单次异常大帧成为长期驻留容量。
+	if (jpeg_buffer_capacity > 1024 * 1024) release_JPEG_buffer();
+	else jpeg_buffer_length = 0;
+}
+
+static int reserve_JPEG_buffer(size_t required)
+{
+	if (required > MAX_JPEG_BUFFER) return 0;
+	if (jpeg_buffer_capacity >= required) return 1;
+	size_t capacity = jpeg_buffer_capacity == 0 ? MAX_BUFFER : jpeg_buffer_capacity;
+	while (capacity < required)
+	{
+		capacity = capacity > MAX_JPEG_BUFFER / 2 ? MAX_JPEG_BUFFER : capacity * 2;
+	}
+	unsigned char *replacement = realloc(jpeg_buffer, capacity);
+	if (replacement == NULL) return 0;
+	jpeg_buffer = replacement;
+	jpeg_buffer_capacity = capacity;
+	return 1;
+}
 
