+
+#define ILibDuktape_net_ActiveSocketRoots "\xFF_scActiveNetSockets"
+static void ILibDuktape_net_socket_RootActive(duk_context *ctx, void *object, int add)
+{
+	if (ctx == NULL || object == NULL || duk_ctx_shutting_down(ctx)) { return; }
+	duk_push_heap_stash(ctx);
+	duk_get_prop_string(ctx, -1, ILibDuktape_net_ActiveSocketRoots);
+	if (!duk_is_object(ctx, -1))
+	{
+		duk_pop(ctx);
+		if (!add) { duk_pop(ctx); return; }
+		duk_push_object(ctx);
+		duk_dup(ctx, -1);
+		duk_put_prop_string(ctx, -3, ILibDuktape_net_ActiveSocketRoots);
+	}
+	if (add)
+	{
+		duk_push_heapptr(ctx, object);
+		duk_put_prop_string(ctx, -2, Duktape_GetStashKey(object));
+	}
+	else
+	{
+		duk_del_prop_string(ctx, -1, Duktape_GetStashKey(object));
+	}
+	duk_pop_2(ctx);
+}
 
