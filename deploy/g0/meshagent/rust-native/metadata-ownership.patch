+static int Duktape_BufferHasMemoryHeader(const char *buffer, duk_size_t len, duk_size_t *payloadLen)
+{
+	ILibMemory_Header header;
+	if (buffer == NULL || len < sizeof(header)) { return(0); }
+	memcpy(&header, buffer, sizeof(header));
+	if (memcmp(&header.CANARY, "broe", sizeof(header.CANARY)) != 0 ||
+		header.memoryType != ILibMemory_Types_OTHER || header.extraSize != 0 ||
+		header.size != len - sizeof(header)) { return(0); }
+	*payloadLen = header.size;
+	return(1);
+}
