+    duk_idx_t emitter = duk_normalize_index(ctx, emitterIdx);
+    duk_idx_t listener = duk_normalize_index(ctx, listenerIdx);
+    duk_push_c_function(ctx, ILibDuktape_EventEmitter_removeListener, 2);
+    duk_dup(ctx, emitter);
