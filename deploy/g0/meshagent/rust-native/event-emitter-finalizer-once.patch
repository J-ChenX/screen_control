+static duk_ret_t ILibDuktape_EventEmitter_TryClearFinalizer(duk_context *ctx)
+{
+	void *expected = duk_get_pointer(ctx, 1);
+	duk_get_finalizer(ctx, 0);
+	void *current = duk_get_heapptr(ctx, -1);
+	duk_pop(ctx);
+	if (current != expected) { return(0); }
+	duk_push_undefined(ctx);
+	duk_set_finalizer(ctx, 0);
+	return(0);
+}
