+/* 显示身份或格式改变时重建 GDI 对象，兼容位图不跨桌面/设备复用。 */
+extern "C" int sc_windows_reset_capture(void)
+{
+    if (hCaptureDC && hCaptureOriginal) SelectObject(hCaptureDC, hCaptureOriginal);
+    if (hCapturedBitmap) DeleteObject(hCapturedBitmap);
+    if (hCaptureDC) DeleteDC(hCaptureDC);
+    if (hDesktopDC) ReleaseDC(NULL, hDesktopDC);
+    hCapturedBitmap = NULL; hCaptureDC = NULL; hCaptureOriginal = NULL;
+    hDesktopDC = GetDC(NULL);
+    if (!hDesktopDC) return 0;
+    hCaptureDC = CreateCompatibleDC(hDesktopDC);
+    if (!hCaptureDC) return 0;
+    hCaptureOriginal = GetCurrentObject(hCaptureDC, OBJ_BITMAP);
+    return hCaptureOriginal != NULL;
+}
+
+/* 连续顶向下 RGB24 仅经既有 GDI+ JPEG 编码，失败不发布半帧。 */
+extern "C" int sc_windows_encode(const unsigned char *rgb, unsigned int width, unsigned int height,
+    int quality, unsigned char **output, size_t *length)
+{
+    *output = NULL; *length = 0;
+    if (!rgb || width == 0 || height == 0 || width > 2560 || height > 1440 || quality < 1 || quality > 100) return 0;
+    size_t stride = ((size_t)width * 3 + 3) & ~(size_t)3;
+    unsigned char *bgr = (unsigned char *)calloc(height, stride);
+    if (!bgr) return 0;
+    for (unsigned int y = 0; y < height; y++) for (unsigned int x = 0; x < width; x++)
+        for (unsigned int c = 0; c < 3; c++) bgr[(size_t)y * stride + x * 3 + c] = rgb[((size_t)y * width + x) * 3 + 2 - c];
+    IStream *stream = NULL;
+    unsigned char *encoded = NULL;
+    int success = 0;
+    {
+        Bitmap bitmap(width, height, (INT)stride, PixelFormat24bppRGB, bgr);
+        ULONG q = (ULONG)quality;
+        EncoderParameters parameters = {};
+        parameters.Count = 1; parameters.Parameter[0].Guid = EncoderQuality;
+        parameters.Parameter[0].Type = EncoderParameterValueTypeLong;
+        parameters.Parameter[0].NumberOfValues = 1; parameters.Parameter[0].Value = &q;
+        if (bitmap.GetLastStatus() == Ok && CreateStreamOnHGlobal(NULL, TRUE, &stream) == S_OK &&
+            bitmap.Save(stream, &encoderClsid, &parameters) == Ok)
+        {
+            STATSTG info = {}; LARGE_INTEGER zero = {}; ULONG read = 0;
+            if (stream->Stat(&info, STATFLAG_NONAME) == S_OK && info.cbSize.QuadPart > 0 && info.cbSize.QuadPart <= 16 * 1024 * 1024 &&
+                stream->Seek(zero, STREAM_SEEK_SET, NULL) == S_OK)
+            {
+                encoded = (unsigned char *)malloc((size_t)info.cbSize.QuadPart);
+                if (encoded && stream->Read(encoded, (ULONG)info.cbSize.QuadPart, &read) == S_OK && read == info.cbSize.QuadPart)
+                { *output = encoded; *length = read; encoded = NULL; success = 1; }
+            }
+        }
+    }
+    if (stream) stream->Release();
+    free(encoded); free(bgr); return success;
+}
 
