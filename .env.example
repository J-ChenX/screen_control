# 复制为 .env 并替换示例值。切勿提交 .env。
# 仅支持字面值：不支持 $VAR 展开、命令替换或多行值。
# ops/with-env 仅加载 SCREEN_CONTROL_*；已导出的环境变量优先于文件配置。
# 这些 Tailscale 地址仅供示例，不代表实际部署清单。
SCREEN_CONTROL_MESH_URL='https://desktop.example.ts.net:4443'
SCREEN_CONTROL_MESH_HOST='desktop.example.ts.net'
SCREEN_CONTROL_MESH_BIND_IP='100.64.0.20'
SCREEN_CONTROL_REGISTERED_IPS='100.64.0.10,100.64.0.20,100.64.0.30'
SCREEN_CONTROL_MESH_PORTAL_ORIGIN='https://portal.example.ts.net'
SCREEN_CONTROL_MESH_USER='g0-desktop'
SCREEN_CONTROL_MESH_FILE_USER='g0-files'
# 可选覆盖项；未设置时使用 XDG_STATE_HOME 或当前用户的主目录。
# SCREEN_CONTROL_MESH_PASSWORD_FILE='/private/secrets/meshcentral-desktop'
# SCREEN_CONTROL_MESH_FILE_PASSWORD_FILE='/private/secrets/meshcentral-files'
SCREEN_CONTROL_DEV_ORIGIN='http://server.example.ts.net:5174'
SCREEN_CONTROL_PREVIEW_ORIGIN='http://server.example.ts.net:4174'
SCREEN_CONTROL_ALLOWED_ORIGINS='http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://server.example.ts.net:5174,http://server.example.ts.net:4174'
SCREEN_CONTROL_TAILSCALE_IP='100.64.0.20'
SCREEN_CONTROL_CLIPBOARD_URL='https://server.example.ts.net:8443'

# 现有设备 ID 是协议标识符，与主机名和 SSH 用户名相互独立。
SCREEN_CONTROL_NIX_IP='100.64.0.10'
SCREEN_CONTROL_NIX_HOSTNAME='workstation'
SCREEN_CONTROL_ECHOVA_IP='100.64.0.20'
SCREEN_CONTROL_ECHOVA_HOSTNAME='server'
SCREEN_CONTROL_ECHOVA_SSH_TARGET='operator@100.64.0.20'
SCREEN_CONTROL_WINDOWS_IP='100.64.0.30'
SCREEN_CONTROL_WINDOWS_HOSTNAME='windows-pc'
SCREEN_CONTROL_WINDOWS_SSH_TARGET='operator@100.64.0.30'
SCREEN_CONTROL_PHONE_IP='100.64.0.40'
SCREEN_CONTROL_PHONE_HOSTNAME='phone'
SCREEN_CONTROL_PROJECT_ROOT='/srv/screen-control'
SCREEN_CONTROL_ECHOVA_DNS_NAME='server'
SCREEN_CONTROL_NIX_DNS_NAME='workstation'
SCREEN_CONTROL_WINDOWS_DNS_NAME='windows-pc'

# 普通用户文件通道：目标用户必须能够读写接收目录；缺失时拒绝文件会话。
SCREEN_CONTROL_FILE_SSH_TARGETS='echova=operator@100.64.0.20,nix=operator@100.64.0.10,jiang-chenx=operator@100.64.0.30'

# 可选：共享收藏的服务端存储；修改时同步配置服务的可写目录。
# SCREEN_CONTROL_FAVORITES_FILE=/path/to/private/state/favorites/folders.json
