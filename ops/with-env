#!/usr/bin/env python3
"""使用私有 SCREEN_CONTROL_* 设置运行命令，不经 shell 求值。"""
import os
from pathlib import Path
import re
import sys


def read_env(path: Path) -> dict[str, str]:
    values = {}
    for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        if not separator or not re.fullmatch(r"SCREEN_CONTROL_[A-Z0-9_]+", key):
            raise ValueError(f"invalid environment key on line {number}")
        value = value.strip()
        if value.startswith(("'", '"')):
            if len(value) < 2 or value[-1] != value[0]:
                raise ValueError(f"unclosed quote on line {number}")
            value = value[1:-1]
        elif any(c.isspace() for c in value):
            raise ValueError(f"quote values containing whitespace on line {number}")
        if "\0" in value:
            raise ValueError(f"invalid value on line {number}")
        values[key] = value
    return values


def main() -> int:
    args = sys.argv[1:]
    if args[:1] == ["--"]:
        args = args[1:]
    if not args:
        print("usage: ops/with-env COMMAND [ARG ...]", file=sys.stderr)
        return 2
    explicit = os.environ.get("SCREEN_CONTROL_ENV_FILE")
    path = Path(explicit) if explicit else Path(__file__).resolve().parents[1] / ".env"
    try:
        values = read_env(path) if explicit or path.exists() else {}
        # 显式导出的环境变量优先，包括空字符串。
        environment = {**values, **os.environ}
        os.execvpe(args[0], args, environment)
    except (OSError, ValueError) as error:
        print(f"environment configuration error: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
